# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
# Used by scripts/apply-migrations.mjs and scripts/db-shell.mjs only.
SUPABASE_DB_PASSWORD=REPLACE_ME

# --- Judge sessions ---
# Signs the jnj.session cookie. At least 32 chars; changing it logs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JUDGE_SESSION_SECRET=REPLACE_ME

# --- Legacy (Google Apps Script backend, superseded by /api/db/*) ---
NEXT_PUBLIC_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_ME/exec
NEXT_PUBLIC_APPS_SCRIPT_TOKEN=REPLACE_ME
